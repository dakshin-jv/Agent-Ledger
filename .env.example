# Copy this file to .env locally. Never commit the copied file or paste values in chat.
# Step 1: PayPal sandbox metadata. Use aliases, not private account passwords.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_APP_NAME='Agent Ledger'
PAYPAL_SANDBOX_REGION=IN
PAYPAL_SANDBOX_MERCHANT_ALIAS=
PAYPAL_SANDBOX_MERCHANT_PASSWORD=
PAYPAL_SANDBOX_BUYER_ALIAS=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_CURRENCY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
CHANNEL3_API_KEY=
# Leave locale unset until supported market coverage is verified.
CHANNEL3_LANGUAGE=
CHANNEL3_COUNTRY=
CHANNEL3_CURRENCY=
# Local development: use Render's External Database URL. In Render service
# settings, use its Internal Database URL for this same variable instead.
DATABASE_URL=
RENDER_API_KEY=
SARVAM_API_KEY=
TYPESAFE_API_KEY=

# Elastic Agent Builder (only required when enabling live Agent Builder tools)
ELASTIC_API_KEY=
ELASTICSEARCH_URL=
ELASTIC_KIBANA_URL=
ELASTIC_AGENT_BUILDER_MCP_URL=

# AG Studio evaluation licence (do not commit a real key or use it in production)
AG_STUDIO_LICENSE_KEY=
AG_STUDIO_TRIAL_EXPIRES_ON=
