{
  "mcpServers": {
    "postman": {
      "url": "https://mcp.postman.com/mcp"
    },
    "paypal-sandbox": {
      "type": "stdio",
      "command": "zsh",
      "args": [
        "-lc",
        "agentledger_paypal_client_id=\"$(sed -n 's/^PAYPAL_CLIENT_ID=//p' '${workspaceFolder}/.env')\"; agentledger_paypal_secret=\"$(sed -n 's/^PAYPAL_CLIENT_SECRET=//p' '${workspaceFolder}/.env')\"; agentledger_paypal_token=\"$(curl --silent --show-error --user \"${agentledger_paypal_client_id}:${agentledger_paypal_secret}\" --data 'grant_type=client_credentials' 'https://api-m.sandbox.paypal.com/v1/oauth2/token' | python3 -c 'import json, sys; print(json.load(sys.stdin)[\"access_token\"])')\"; exec npx -y mcp-remote 'https://mcp.sandbox.paypal.com/sse' --header \"Authorization: Bearer ${agentledger_paypal_token}\""
      ]
    },
    "render": {
      "url": "https://mcp.render.com/mcp",
      "auth": {
        "CLIENT_ID": "cursor"
      }
    },
    "elastic-docs": {
      "url": "https://www.elastic.co/docs/_mcp/"
    },
    "elastic-agent-builder": {
      "type": "stdio",
      "command": "zsh",
      "args": [
        "-lc",
        "agentledger_elastic_url=\"$(sed -n 's/^ELASTIC_AGENT_BUILDER_MCP_URL=//p' '${workspaceFolder}/.env')\"; agentledger_elastic_key=\"$(sed -n 's/^ELASTIC_API_KEY=//p' '${workspaceFolder}/.env')\"; exec npx -y mcp-remote \"$agentledger_elastic_url\" --header \"Authorization:ApiKey $agentledger_elastic_key\""
      ]
    },
    "channel3": {
      "type": "stdio",
      "command": "zsh",
      "args": [
        "-lc",
        "agentledger_channel3_key=\"$(sed -n 's/^CHANNEL3_API_KEY=//p' '${workspaceFolder}/.env')\"; exec npx -y mcp-remote 'https://mcp.trychannel3.com' --header \"Authorization: Bearer ${agentledger_channel3_key}\""
      ]
    },
    "sarvam": {
      "type": "stdio",
      "command": "uvx",
      "args": ["sarvam-mcp"],
      "envFile": "${workspaceFolder}/.env"
    },
    "typesafe": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "typesafe-mcp==0.5.2", "typesafe-mcp"],
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "TYPESAFE_DEFAULT_MODEL": "jev-latest"
      }
    },
    "bryntum": {
      "url": "https://mcp.bryntum.com"
    },
    "ag-grid": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "ag-mcp"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
